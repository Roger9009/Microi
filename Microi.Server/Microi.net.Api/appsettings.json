{
  "AppSettings": {
    "//" : "OsClient、OsClientType、OsClientNetwork、OsClientDbConn 必填",
    "//License": "License 授权相关配置（可不填，使用默认值）",
    "LicenseHeartbeatUrl": "https://api.itdos.com/api/License/Heartbeat",
    "LicenseContactEmail": "474765852@qq.com",
    "OsClient": "iTdos",
    "OsClientType": "Product",
    "OsClientNetwork": "Internal",
    "OsClientDbType": "SqlServer",
    "OsClientDbConn": "Server=localhost;Database=microi;User Id=sa;Password=Sa1234;TrustServerCertificate=true;",
    "OsClientRedisHost": "127.0.0.1",
    "OsClientRedisPort": "6379",
    "OsClientRedisPwd": "123456",
    "OsClientRedisDataBase": "5",
    "OsClientDbMongoConn": ""
  },
  "DevLoginBypass": {
    "//": "本地开发/自动化测试旁路。仅在 Development 环境启用；生产环境请勿设置 Enabled=true。",
    "Enabled": true,
    "SkipCaptcha": true,
    "OnlyLoopback": true,
    "DefaultAccount": "admin",
    "DefaultPassword": "demo123456",
    "Accounts": [
      {
        "OsClient": "testTenantKey",
        "Account": "admin",
        "Password": "demo123456"
      }
    ]
  },
  "BusinessBypass": {
    "//": "业务底座开发配置。仅在本地开发环境使用，生产环境不要添加此节或设 Enabled=false。",
    "Enabled": true,
    "//BizAdminDefaultPwd": "业务底座独立管理员默认密码（BusinessAuthController），登录为 bizadmin",
    "BizAdminDefaultPwd": "Admin@123",
    "//AutoMigrate": "启动时是否自动建表/补列（覆盖 AddMicroiBusiness 的 AutoMigrate 配置）",
    "AutoMigrate": true,
    "//MonitorInterval": "模块监控健康检查间隔（秒）",
    "MonitorIntervalSec": 60,
    "//DebugMode": "启用后输出更详细的业务模块生命周期日志",
    "DebugMode": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error",
      "Microsoft.AspNetCore": "Error",
      "Quartz": "Error",
      "IdentityServer4": "Error",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.AspNetCore.HttpsPolicy": "Error",
      "Microsoft.AspNetCore.Hosting": "Error",
      "Microsoft.AspNetCore.StaticAssets": "Error"
    }
  },
  "StaticWebAssets": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
